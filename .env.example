# ========================================================
# Gestor Financiero - Environment Configuration
# ========================================================
# Duplicate this file to .env and adjust credentials if needed.
# The system also includes smart auto-detection for standard
# local environments (XAMPP, Laragon, MAMP, and Docker).

# Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gestor_financiero
DB_USER=root
DB_PASS=

# --------------------------------------------------------
# Standard Presets Quick Reference:
# --------------------------------------------------------
# XAMPP / Laragon (Default):
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_USER=root
#   DB_PASS=
#
# MAMP:
#   DB_HOST=127.0.0.1
#   DB_PORT=8889
#   DB_USER=root
#   DB_PASS=root
#
# Docker (via docker-compose.yml):
#   DB_HOST=db
#   DB_PORT=3306
#   DB_USER=root
#   DB_PASS=root
# --------------------------------------------------------

